@prefix rml: <http://w3id.org/rml/> .
@prefix ex: <http://example.com/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .
@base <http://example.com/base/> .

<#TriplesMap> a rml:TriplesMap;

    rml:logicalSource [
        rml:source "test/geo/geoparquet/RMLTC0001a/data.parquet";
        rml:referenceFormulation rml:GEOPARQUET;
    ];

    rml:subjectMap [
        rml:template "http://example.com/{id}";
        rml:class ex:Feature
    ];

    rml:predicateObjectMap [
        rml:predicate ex:geometry;
        rml:objectMap [
            rml:reference "geometry";
            rml:datatype xsd:string
        ]
    ];

    rml:predicateObjectMap [
        rml:predicate ex:name;
        rml:objectMap [
            rml:reference "name"
        ]
    ] .
