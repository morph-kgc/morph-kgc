@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex:  <http://data.example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <http://example.com/base/> .

<TMA> a rml:TriplesMap ;
  rml:logicalSource [ rml:source "test/rml12/RML12TC008a/data.csv" ; rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "http://data.example.org/a/{id}" ] ;
  rml:predicateObjectMap [
    rml:predicate ex:p ;
    rml:objectMap [ rml:tripleTermMap <TMB> ]
  ] .

<TMB> a rml:TriplesMap ;
  rml:logicalSource [ rml:source "test/rml12/RML12TC008a/data.csv" ; rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "http://data.example.org/b/{id}" ] ;
  rml:predicateObjectMap [
    rml:predicate ex:q ;
    rml:objectMap [ rml:tripleTermMap <TMA> ]
  ] .
