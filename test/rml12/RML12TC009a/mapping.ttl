@prefix rml: <http://w3id.org/rml/> .
@prefix rdf: <http://www.w3.org/1999/02/22-rdf-syntax-ns#> .
@prefix ex:  <http://data.example.org/> .
@prefix xsd: <http://www.w3.org/2001/XMLSchema#> .

@base <http://example.com/base/> .

<TMEmpty> a rml:TriplesMap ;
  rml:logicalSource [ rml:source "test/rml12/RML12TC009a/data.csv" ; rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "http://data.example.org/film/{id}" ] .

<TMReif> a rml:TriplesMap ;
  rml:logicalSource [ rml:source "test/rml12/RML12TC009a/data.csv" ; rml:referenceFormulation rml:CSV ] ;
  rml:subjectMap [ rml:template "http://data.example.org/reification/{id}" ] ;
  rml:predicateObjectMap [
    rml:predicate rdf:reifies ;
    rml:objectMap [ rml:tripleTermMap <TMEmpty> ]
  ] .
