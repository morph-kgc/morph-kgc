@prefix rml: <http://w3id.org/rml/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix morph-fn: <urn:morph:function:> .
@prefix bi: <https://example.org/ontology/> .

@base <http://example.com/base/> .

# Four reconciliations in one mapping: two of them send the same query to the
# same endpoint, the third sends another query to that endpoint, and the fourth
# sends the first query to another endpoint.

<#PatientsMapping>
    a rml:TriplesMap ;
    rml:logicalSource [
        rml:source "test/rml-fnml/reconciliation/clinical_trials.csv" ;
        rml:referenceFormulation rml:CSV
    ] ;
    rml:subjectMap [
        rml:template "urn:id:{patient_id}"
    ] ;
    rml:predicateObjectMap [
        rml:predicate bi:participatesIn ;
        rml:objectMap [
            rml:functionExecution <#ClinicalTrialReconciliation> ;
            rml:termType rml:IRI
        ]
    ] ;
    rml:predicateObjectMap [
        rml:predicate bi:enrolledIn ;
        rml:objectMap [
            rml:functionExecution <#ClinicalTrialReconciliationAgain> ;
            rml:termType rml:IRI
        ]
    ] ;
    rml:predicateObjectMap [
        rml:predicate bi:receives ;
        rml:objectMap [
            rml:functionExecution <#DrugReconciliation> ;
            rml:termType rml:IRI
        ]
    ] ;
    rml:predicateObjectMap [
        rml:predicate bi:registeredIn ;
        rml:objectMap [
            rml:functionExecution <#PublicClinicalTrialReconciliation> ;
            rml:termType rml:IRI
        ]
    ] .

<#ClinicalTrialReconciliation>
    rml:function morph-fn:reconcileEntityOverSPARQL ;
    rml:input [
        rml:parameter morph-fn:sparqlEndpointUrl ;
        rml:inputValue "https://data.com/database/query"
    ] ;
    rml:input [
        rml:parameter morph-fn:sparqlQuery ;
        rml:inputValue """
            PREFIX schema: <https://schema.org/>
            SELECT ?entity_iri ?matching_value_1 WHERE {
                GRAPH ?g {
                    ?entity_iri a schema:MedicalStudy ;
                                schema:identifier ?matching_value_1 .
                }
            }
        """
    ] ;
    rml:input [
        rml:parameter grel:valueParam ;
        rml:inputValueMap [ rml:reference "clinical_trial_id" ]
    ] .

<#ClinicalTrialReconciliationAgain>
    rml:function morph-fn:reconcileEntityOverSPARQL ;
    rml:input [
        rml:parameter morph-fn:sparqlEndpointUrl ;
        rml:inputValue "https://data.com/database/query"
    ] ;
    rml:input [
        rml:parameter morph-fn:sparqlQuery ;
        rml:inputValue """
            PREFIX schema: <https://schema.org/>
            SELECT ?entity_iri ?matching_value_1 WHERE {
                GRAPH ?g {
                    ?entity_iri a schema:MedicalStudy ;
                                schema:identifier ?matching_value_1 .
                }
            }
        """
    ] ;
    rml:input [
        rml:parameter grel:valueParam ;
        rml:inputValueMap [ rml:reference "clinical_trial_id" ]
    ] .

<#DrugReconciliation>
    rml:function morph-fn:reconcileEntityOverSPARQL ;
    rml:input [
        rml:parameter morph-fn:sparqlEndpointUrl ;
        rml:inputValue "https://data.com/database/query"
    ] ;
    rml:input [
        rml:parameter morph-fn:sparqlQuery ;
        rml:inputValue """
            PREFIX schema: <https://schema.org/>
            SELECT ?entity_iri ?matching_value_1 WHERE {
                GRAPH ?g { ?entity_iri a schema:Drug ; schema:name ?matching_value_1 . }
            }
        """
    ] ;
    rml:input [
        rml:parameter grel:valueParam ;
        rml:inputValueMap [ rml:reference "drug" ]
    ] .

<#PublicClinicalTrialReconciliation>
    rml:function morph-fn:reconcileEntityOverSPARQL ;
    rml:input [
        rml:parameter morph-fn:sparqlEndpointUrl ;
        rml:inputValue "https://data.com/public/query"
    ] ;
    rml:input [
        rml:parameter morph-fn:sparqlQuery ;
        rml:inputValue """
            PREFIX schema: <https://schema.org/>
            SELECT ?entity_iri ?matching_value_1 WHERE {
                GRAPH ?g {
                    ?entity_iri a schema:MedicalStudy ;
                                schema:identifier ?matching_value_1 .
                }
            }
        """
    ] ;
    rml:input [
        rml:parameter grel:valueParam ;
        rml:inputValueMap [ rml:reference "clinical_trial_id" ]
    ] .
