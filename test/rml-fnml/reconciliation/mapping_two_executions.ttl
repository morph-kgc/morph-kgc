@prefix rml: <http://w3id.org/rml/> .
@prefix grel: <http://users.ugent.be/~bjdmeest/function/grel.ttl#> .
@prefix morph-fr: <urn:morph:function:reconciliation:> .
@prefix morph-fn: <urn:morph:function:> .
@prefix skos: <http://www.w3.org/2004/02/skos/core#> .
@prefix ex: <https://example.org/kg/> .

@base <http://example.com/base/> .

# Two executions of the same function: one matches against the attribute it
# names, the other names none and matches against those of the resource.
<#PatientsMapping>
    a rml:TriplesMap ;
    rml:logicalSource [
        rml:source "test/rml-fnml/reconciliation/patients.csv" ;
        rml:referenceFormulation rml:CSV
    ] ;
    rml:subjectMap [
        rml:template "https://example.org/kg/patient/{pid}"
    ] ;
    rml:predicateObjectMap [
        rml:predicate ex:diseaseByAltLabel ;
        rml:objectMap [
            rml:functionExecution <#AltLabelReconciliationExecution> ;
            rml:termType rml:IRI
        ]
    ] ;
    rml:predicateObjectMap [
        rml:predicate ex:disease ;
        rml:objectMap [
            rml:functionExecution <#DiseaseReconciliationExecution> ;
            rml:termType rml:IRI
        ]
    ] .

<#AltLabelReconciliationExecution>
    rml:function morph-fr:reconcileVocabularyConcept ;
    rml:input [
        rml:parameter grel:valueParam ;
        rml:inputValueMap [ rml:reference "disease_label" ]
    ] ;
    rml:input [
        rml:parameter grel:attributeIRI ;
        rml:inputValue skos:altLabel
    ] .

<#DiseaseReconciliationExecution>
    rml:function morph-fr:reconcileVocabularyConcept ;
    rml:input [
        rml:parameter grel:valueParam ;
        rml:inputValueMap [ rml:reference "disease_label" ]
    ] .
